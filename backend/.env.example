# Echo backend configuration.
# Copy to backend/.env and fill in. Never commit the filled-in file.
# Anything left blank keeps that channel in SIMULATION mode: the message and
# call script are composed, logged, and shown in the app, but nothing is sent.

# --- Telegram -------------------------------------------------------------
# Create a bot with @BotFather, paste the token here, then have each emergency
# contact open the bot and press Start. The app's contact editor can then list
# those chats (Contacts -> add/edit -> "Find chats that started the bot").
TELEGRAM_BOT_TOKEN=

# --- Automated voice call (Twilio REST; no SDK needed) --------------------
# The call speaks a short alert and then plays the 5-second clip Echo heard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Publicly reachable base URL of THIS backend. Twilio fetches the TwiML
# document and the evidence clip from it, so localhost cannot work -- use a
# tunnel during development, e.g.:
#   ngrok http 8010     ->  ECHO_PUBLIC_BASE_URL=https://<id>.ngrok-free.app
ECHO_PUBLIC_BASE_URL=

# --- Escalation policy ----------------------------------------------------
# Master switch for all outbound contact alerts.
ECHO_ESCALATION_ENABLED=1
# Seconds the person in the room has to cancel before contacts are alerted.
ECHO_CANCEL_WINDOW_SECONDS=12
# Minimum risk score (0-100) that may auto-escalate.
ECHO_MIN_ESCALATION_RISK=61
# Minimum seconds between two escalations for the same user.
ECHO_ESCALATION_COOLDOWN_SECONDS=120
# How long evidence clips are kept before being deleted (default 7 days).
ECHO_CLIP_RETENTION_SECONDS=604800
